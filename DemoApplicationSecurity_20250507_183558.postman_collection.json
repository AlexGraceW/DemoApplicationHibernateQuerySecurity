            },
            {
              "key": "password",
              "value": "1234",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Public Endpoint (No Auth)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/products/public",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "products",
            "public"
          ]
        }
      }
    }
  ]
