  },
  "item": [
    {
      "name": "Get All Products (Protected)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/products/all",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
